% Definition of OutputIntent
/ICCProfile (/usr/share/ghostscript/10.07.1/iccprofiles/default_rgb.icc) def

[/_objdef {icc_PDFA} /type /stream /OBJ pdfmark
[{icc_PDFA} << /N 3 /Filter /FlateDecode >> /PUT pdfmark
[{icc_PDFA} ICCProfile (r) file /PUT pdfmark

[/GTS_PDFA1 /Title (sRGB) /OutputConditionIdentifier (sRGB) /DestOutputProfile {icc_PDFA} /PDFMark /OutputIntent pdfmark
